---
import Layout from "../layouts/Layout.astro";
import FadeIn from "../components/FadeIn.tsx";
import ImageReveal from "../components/ImageReveal.tsx";

const base = import.meta.env.BASE_URL;
---

<Layout>
  <main class="h-screen flex items-center justify-center overflow-hidden">
    <div class="w-full max-w-6xl mx-auto px-6 md:px-12 py-8 md:py-0">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">

        <!-- Left: Text + Contact -->
        <FadeIn client:load>
          <div class="space-y-6 text-center md:text-left">
            <span class="inline-block text-xs tracking-[.3em] uppercase text-gold font-medium">
              Cambrils, Barcelona
            </span>

            <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-bold text-charcoal tracking-tight leading-none">
              La Perla
            </h1>

            <div class="flex items-center gap-4 justify-center md:justify-start">
              <span class="block h-px w-10 bg-gold/40" />
              <span class="w-1.5 h-1.5 rounded-full bg-gold" />
              <span class="block h-px w-10 bg-gold/40" />
            </div>

            <p class="text-charcoal-light text-base md:text-lg font-light max-w-xs mx-auto md:mx-0 leading-relaxed">
              Un rincón junto al mar donde el tiempo se detiene
            </p>

            <a
              href="tel:+34636473596"
              class="group inline-flex items-center gap-3 text-lg md:text-xl font-light text-charcoal-light hover:text-gold-dark transition-colors duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gold group-hover:text-gold-dark transition-colors duration-300"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              +34 636 47 35 96
            </a>
          </div>
        </FadeIn>

        <!-- Right: Images -->
        <FadeIn client:load delay={0.2}>
          <div class="space-y-3 md:space-y-4">
            <ImageReveal
              client:load
              src={`${base}/images/image-1.jpeg`}
              alt="La Perla - Interior"
              className="aspect-[4/3] rounded-lg w-full"
              delay={0}
            />
            <ImageReveal
              client:load
              src={`${base}/images/image-2.jpeg`}
              alt="La Perla - Vista"
              className="aspect-[4/3] rounded-lg w-full"
              delay={0.15}
            />
          </div>
        </FadeIn>

      </div>
    </div>
  </main>
</Layout>
