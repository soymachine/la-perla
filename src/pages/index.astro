---
import Layout from "../layouts/Layout.astro";
import FadeIn from "../components/FadeIn.tsx";
import ImageReveal from "../components/ImageReveal.tsx";
---

<Layout>
  <main class="min-h-screen">
    <!-- Hero -->
    <section class="relative min-h-screen flex flex-col items-center justify-center px-6 py-20">
      <div class="absolute inset-0 bg-gradient-to-b from-pearl-dark/50 to-pearl pointer-events-none" />

      <FadeIn client:load>
        <div class="relative text-center space-y-6">
          <span
            class="inline-block text-xs tracking-[.3em] uppercase text-gold font-medium mb-4"
          >
            Cambrils, Barcelona
          </span>

          <h1 class="font-serif text-6xl md:text-8xl lg:text-9xl font-bold text-charcoal tracking-tight leading-none">
            La Perla
          </h1>

          <div class="flex items-center justify-center gap-4 pt-2">
            <span class="block h-px w-12 bg-gold/40" />
            <span class="w-1.5 h-1.5 rounded-full bg-gold" />
            <span class="block h-px w-12 bg-gold/40" />
          </div>

          <p class="text-charcoal-light text-lg md:text-xl font-light max-w-md mx-auto leading-relaxed pt-2">
            Un rincón junto al mar donde el tiempo se detiene
          </p>
        </div>
      </FadeIn>

      <!-- Scroll indicator -->
      <FadeIn client:load delay={0.6}>
        <div class="absolute bottom-10 flex flex-col items-center gap-2">
          <span class="text-xs tracking-[.2em] uppercase text-charcoal-light/50">Descubrir</span>
          <div class="w-px h-8 bg-gradient-to-b from-gold/60 to-transparent" />
        </div>
      </FadeIn>
    </section>

    <!-- Gallery -->
    <section class="px-6 md:px-12 pb-20 md:pb-32 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <ImageReveal
          client:load
          src="/images/image-1.jpeg"
          alt="La Perla - Interior"
          className="aspect-[4/3] rounded-lg"
          delay={0}
        />
        <ImageReveal
          client:load
          src="/images/image-2.jpeg"
          alt="La Perla - Vista"
          className="aspect-[4/3] rounded-lg"
          delay={0.15}
        />
      </div>
    </section>

    <!-- Contact -->
    <section class="px-6 pb-32">
      <FadeIn client:load>
        <div class="max-w-2xl mx-auto text-center space-y-8">
          <div class="flex items-center justify-center gap-4">
            <span class="block h-px w-12 bg-gold/40" />
            <span class="w-1.5 h-1.5 rounded-full bg-gold" />
            <span class="block h-px w-12 bg-gold/40" />
          </div>

          <h2 class="font-serif text-3xl md:text-4xl font-semibold text-charcoal">
            Reservas y consultas
          </h2>

          <a
            href="tel:+34636473596"
            class="group inline-flex items-center gap-3 text-xl md:text-2xl font-light text-charcoal-light hover:text-gold-dark transition-colors duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-gold group-hover:text-gold-dark transition-colors duration-300"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            +34 636 47 35 96
          </a>
        </div>
      </FadeIn>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gold/20 px-6 py-8">
      <FadeIn client:load>
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-charcoal-light/60">
          <span class="font-serif text-lg text-gold/60 italic">La Perla</span>
          <span>Cambrils, Costa Daurada</span>
        </div>
      </FadeIn>
    </footer>
  </main>
</Layout>
